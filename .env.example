# Opt-in account preview. Public production remains disabled by default.
NEXT_PUBLIC_ENABLE_ACCOUNTS=false
NEXT_PUBLIC_AUTH_ENV=development
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Trusted origins, comma-separated, without trailing slashes.
# Development also supports https://feat-*.YOUR-PROJECT.pages.dev (one host label).
NEXT_PUBLIC_ACCOUNT_ORIGINS=
# Only configured providers: google,apple. Empty enables email-only UI.
NEXT_PUBLIC_AUTH_PROVIDERS=

# Enable only after applying the account workspace migration in dev.
NEXT_PUBLIC_ENABLE_CLOUD_COOKS=false
